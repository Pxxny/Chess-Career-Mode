+  }
+  await page.locator('[data-square="e2"]').click();
+  await expect(page.locator('[data-square="e4"]')).toHaveAttribute('data-target', 'true');
+  await page.locator('[data-square="e4"]').click();
+  await expect(page.getByTestId('move-list').locator('button[data-ply="2"]')).toBeVisible();
+  await page.getByRole('button', { name: 'Resign', exact: true }).click();
+  await expect(page.getByTestId('result-banner')).toBeVisible();
+  const finished = await whiteClock.textContent();
