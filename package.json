{
  "name": "chess-career-mode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/build-world-data.mjs && node scripts/copy-engine.mjs",
    "build:data": "node scripts/build-world-data.mjs --force",
    "test:play": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-play.ts",
    "test:world": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-world.ts",
    "test:e2e": "playwright test",
    "test:data": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-data.ts",
    "test:match": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-match.ts",
    "test:session": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-session.ts",
    "test:engine": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-engine.ts",
    "test:engine:browser": "node scripts/verify-engine-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stockfish": "^16.0.0",
    "world-countries": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "all-the-cities": "^3.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
